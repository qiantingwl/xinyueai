{
  "name": "xinyue-ai",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.cjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "audit:ui-actions": "node scripts/audit-ui-actions.mjs",
    "verify": "npm run audit:ui-actions && npm run build && npm run server:build && npm run admin:build",
    "clean": "node scripts/clean.cjs",
    "clean:reports": "node scripts/clean.cjs --reports",
    "test": "npm run test:unit",
    "test:e2e": "playwright test",
    "test:unit": "tsx --tsconfig server/tsconfig.json --test tests/unit/*.test.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "screenshots:demo": "node scripts/capture-demo-screenshots.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "admin:dev": "pnpm --dir admin dev",
    "admin:build": "pnpm --dir admin build",
    "build:all": "npm run build && npm run admin:build",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "setup:dev": "node scripts/setup-dev.cjs",
    "backup:production": "node scripts/backup-production.cjs",
    "restore:production": "node scripts/restore-production.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue-flow/node-resizer": "^1.5.1",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.2",
    "katex": "^0.16.47",
    "lucide-vue-next": "^0.539.0",
    "marked": "^18.0.9",
    "marked-katex-extension": "^5.1.12",
    "naive-ui": "^2.43.1",
    "pinia": "^3.0.3",
    "vite": "^7.1.2",
    "vue": "^3.5.18",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vue-tsc": "^3.0.5"
  }
}
