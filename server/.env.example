NODE_ENV=development
PORT=3100
WEB_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:4173
PUBLIC_BASE_URL=
COOKIE_SECURE=false
TRUST_PROXY=false
HEALTH_CHECK_TIMEOUT_MS=3000
# Re-scan expired generation leases after worker restarts. This recovery loop
# cannot be disabled; invalid or non-positive values fall back to 30000 ms.
GENERATION_STALE_LEASE_REAPER_INTERVAL_MS=30000
# Role "flux" and database "flux_studio" are internal identifiers, not the product name.
DATABASE_URL=postgresql://flux:flux_dev_password@localhost:5432/flux_studio?schema=public
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate a unique value before using setup:dev on a shared environment.
INSTALL_TOKEN=replace-with-a-random-install-token
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=10
# Echo login codes back in the API response. Development only, opt-in, and always
# ignored unless NODE_ENV=development.
DEV_OTP_EXPOSE=false
GLOBAL_RATE_LIMIT=600
# Development can be more permissive; use 8 or lower in production.
ADMIN_LOGIN_RATE_LIMIT=30
# Per-account admin login budget, applied alongside the per-IP limit above so a
# distributed attacker cannot keep guessing one account. The lock doubles for each
# failure past the budget, up to ADMIN_LOGIN_MAX_LOCK_SECONDS, and a successful
# login resets the counter.
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_FAILURE_WINDOW_MINUTES=15
ADMIN_LOGIN_LOCK_SECONDS=60
ADMIN_LOGIN_MAX_LOCK_SECONDS=900
UPLOAD_DIR=uploads
# Hard ceiling for reading a single stored object into the process.
STORAGE_MAX_READ_MB=64
# Budgets for one data-export job; exceeding either fails the job instead of the process.
EXPORT_MAX_MB=512
EXPORT_MAX_ROWS_PER_COLLECTION=100000
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_CHAT_MODEL=gpt-4.1
AI_IMAGE_MODEL=gpt-image-1
# Optional: outbound proxy used by remote prompt-library synchronization.
HTTPS_PROXY=
# External community content is disabled until the deployment owner reviews its licenses.
PROMPT_LIBRARY_EXTERNAL_SYNC_ENABLED=false
EXTERNAL_SKILL_MARKET_ENABLED=true
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-different-32-character-secret
# Only applies to admin-managed LOCAL_WORKER channels. Public Providers never
# use this exception and must resolve exclusively to public addresses.
LOCAL_WORKER_ALLOWED_HOSTS=
# Optional web search integration used by the Agent mode.
WEB_SEARCH_ENDPOINT=https://api.tavily.com/search
WEB_SEARCH_API_KEY=
# First-run installer state. INSTALL_TOKEN (above) is required while the
# installer is enabled; these values are managed by the installer itself.
INSTALL_COMPLETED=false
INSTALL_ENV_PATH=
INSTALL_ENV_OVERRIDE=false
INSTALL_AUTO_RESTART=false
