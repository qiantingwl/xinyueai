NODE_ENV=development
PORT=3100
WEB_ORIGIN=http://localhost:5173,http://localhost:5175
COOKIE_SECURE=false
DATABASE_URL=postgresql://flux:flux_dev_password@localhost:5432/flux_studio?schema=public
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=10
GLOBAL_RATE_LIMIT=600
UPLOAD_DIR=uploads
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_CHAT_MODEL=gpt-4.1
AI_IMAGE_MODEL=gpt-image-1
# Optional: outbound proxy used by remote prompt-library synchronization.
HTTPS_PROXY=
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-different-32-character-secret
WEB_SEARCH_ENDPOINT=https://api.tavily.com/search
WEB_SEARCH_API_KEY=
INSTALL_TOKEN=
INSTALL_COMPLETED=false
INSTALL_ENV_PATH=
INSTALL_ENV_OVERRIDE=false
INSTALL_AUTO_RESTART=false
