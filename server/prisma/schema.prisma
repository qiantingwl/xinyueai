  model              String
  status             String
  startedAt          DateTime      @default(now())
  endedAt            DateTime?
  errorCode          String?
  errorMessage       String?       @db.Text
  inputTokens        Int           @default(0)
  outputTokens       Int           @default(0)
  upstreamCostMicros Int           @default(0)
  metadata           Json?
  generation         GenerationJob @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([generationId, startedAt])
  @@index([provider, status, startedAt])
}

model AgentTask {
  id               String          @id @default(cuid())
  userId           String
  projectId        String?
  assistantId      String?
  conversationId   String?         @unique
  generationJobId  String?         @unique
  title            String
  goal             String          @db.Text
  instructions     String          @default("") @db.Text
  model            String
  skillId          String          @default("daily")
  pluginId         String?
  attachmentIds    Json?
  webSearchEnabled Boolean         @default(true)
  sourceTaskId     String?
  scheduleId       String?
  scheduledFor     DateTime?
  status           AgentTaskStatus @default(DRAFT)
  errorMessage     String?         @db.Text
  startedAt        DateTime?
  completedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assistant        Assistant?      @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  conversation     Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  generationJob    GenerationJob?  @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  steps            AgentTaskStep[]
  runs             AgentRun[]
  events           AgentEvent[]
  toolCalls        AgentToolCall[]
  schedule         AgentSchedule?  @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, scheduledFor])
  @@index([userId, updatedAt])
  @@index([userId, status])
  @@index([projectId])
  @@index([assistantId])
  @@index([userId, archivedAt, updatedAt])
  @@index([scheduleId, scheduledFor])
}

model AgentSchedule {
  id                  String      @id @default(cuid())
  userId              String
  title               String
  goal                String      @db.Text
  instructions        String      @default("") @db.Text
  model               String
  skillId             String      @default("daily")
  assistantId         String?
  projectId           String?
  pluginId            String?
  attachmentIds       Json?
  webSearchEnabled    Boolean     @default(true)
  cronExpression      String
  timezone            String      @default("Asia/Shanghai")
  enabled             Boolean     @default(true)
  lastTaskId          String?
  lastRunAt           DateTime?
  nextRunAt           DateTime?
  consecutiveFailures Int         @default(0)
  lastError           String      @default("") @db.Text
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks               AgentTask[]

  @@index([userId, enabled, updatedAt])
  @@index([enabled, nextRunAt])
}

model AgentRun {
  id               String          @id @default(cuid())
  agentTaskId      String
  runKey           String          @unique
  status           AgentTaskStatus @default(QUEUED)
  currentNode      String          @default("prepare")
  iteration        Int             @default(0)
  maxIterations    Int             @default(3)
  maxToolCalls     Int             @default(16)
  maxSearchQueries Int             @default(8)
  maxCreditCost    Int             @default(100)
  timeoutSeconds   Int             @default(900)
  toolCallCount    Int             @default(0)
  searchQueryCount Int             @default(0)
  creditCost       Int             @default(0)
  deadlineAt       DateTime?
  plan             Json?
  context          Json?
  verifierFeedback String          @default("") @db.Text
  finalAnswer      String          @default("") @db.Text
  artifactIds      Json?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  agentTask        AgentTask       @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  events           AgentEvent[]
  toolCalls        AgentToolCall[]

  @@index([agentTaskId, createdAt])
  @@index([status, updatedAt])
}

model AgentEvent {
  id          String    @id @default(cuid())
  agentTaskId String
  runId       String
  type        String
  title       String
  detail      String    @default("") @db.Text
  payload     Json?
  createdAt   DateTime  @default(now())
  agentTask   AgentTask @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  run         AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([agentTaskId, createdAt])
  @@index([runId, createdAt])
}

model AgentToolCall {
  id               String          @id @default(cuid())
  agentTaskId      String
  runId            String
  toolId           String?
  iteration        Int
  position         Int
  key              String
  name             String
  input            Json
  output           Json?
  status           String          @default("PENDING")
  requiresApproval Boolean         @default(false)
  approvalStatus   String          @default("NOT_REQUIRED")
  error            String?         @db.Text
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  agentTask        AgentTask       @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)
  run              AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  tool             ToolDefinition? @relation(fields: [toolId], references: [id], onDelete: SetNull)

  @@unique([runId, iteration, position])
  @@index([agentTaskId, status, createdAt])
  @@index([toolId, createdAt])
}

model AgentTaskStep {
  id          String              @id @default(cuid())
  agentTaskId String
  position    Int
  title       String
  detail      String              @default("") @db.Text
  status      AgentTaskStepStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  agentTask   AgentTask           @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)

  @@unique([agentTaskId, position])
  @@index([agentTaskId, position])
}

model JobOutput {
  id       String        @id @default(cuid())
  jobId    String
  assetId  String
  position Int           @default(0)
  job      GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  asset    Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([jobId, assetId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model NotificationTemplate {
  id                     String                @id @default(cuid())
  key                    String                @unique
  name                   String
  description            String                @default("") @db.Text
  titleTemplate          String
  bodyTemplate           String                @db.Text
  channels               NotificationChannel[] @default([IN_APP])
  enabled                Boolean               @default(true)
  webhookUrl             String                @default("") @db.Text
  encryptedWebhookSecret String                @default("") @db.Text
  webhookSecretHint      String                @default("")
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([enabled, key])
}

model NotificationDelivery {
  id          String                     @id @default(cuid())
  templateKey String
  userId      String?
  channel     NotificationChannel
  recipient   String                     @default("")
  status      NotificationDeliveryStatus @default(PENDING)
  title       String
  body        String                     @db.Text
  metadata    Json?
  attempts    Int                        @default(0)
  lastError   String                     @default("") @db.Text
  sentAt      DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  user        User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([templateKey, createdAt])
}

model ReferralCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled, createdAt])
}

model Invitation {
  id                      String              @id @default(cuid())
  inviterId               String
  inviteeId               String              @unique
  code                    String
  status                  ReferralStatus      @default(REGISTERED)
  qualifyingTransactionId String?             @unique
  qualifiedAmountCents    Int                 @default(0)
  reward                  Int                 @default(0)
  payableAt               DateTime?
  rewardedAt              DateTime?
  reversedAt              DateTime?
  reviewedAt              DateTime?
  reviewedById            String?
  reviewReason            String              @default("") @db.Text
  riskFlags               Json?
  registrationIpHash      String              @default("")
  registrationAgentHash   String              @default("")
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  inviter                 User                @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee                 User                @relation("Invitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  qualifyingTransaction   PaymentTransaction? @relation("ReferralQualifyingTransaction", fields: [qualifyingTransactionId], references: [id], onDelete: SetNull)

  @@index([inviterId, status, createdAt])
  @@index([status, payableAt])
  @@index([code, createdAt])
}

model RedemptionCode {
  id         String    @id @default(cuid())
  name       String    @default("")
  codePrefix String    @default("")
  codeHash   String    @unique
  credits    Int
  maxUses    Int       @default(1)
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
}

model AnnouncementCampaign {
  id             String     @id @default(cuid())
  title          String
  body           String     @db.Text
  targetGroupId  String?
  recipientCount Int        @default(0)
  createdById    String
  createdAt      DateTime   @default(now())
  targetGroup    UserGroup? @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  ipAddress  String?
  userAgent  String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model ModerationPolicy {
  id            String   @id @default("global")
  enabled       Boolean  @default(true)
  scanChat      Boolean  @default(true)
  scanImage     Boolean  @default(true)
  scanCommerce  Boolean  @default(true)
  failClosed    Boolean  @default(true)
  blockMessage  String   @default("内容未通过安全检查，请修改后重试。")
  retainContent Boolean  @default(false)
  excerptLength Int      @default(240)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ModerationRule {
  id            String             @id @default(cuid())
  name          String
  category      String             @default("自定义")
  type          ModerationRuleType @default(KEYWORD)
  pattern       String             @db.Text
  action        ModerationAction   @default(BLOCK)
  caseSensitive Boolean            @default(false)
  enabled       Boolean            @default(true)
  sortOrder     Int                @default(0)
  description   String             @default("") @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([enabled, sortOrder])
  @@index([category])
}

model ModerationEvent {
  id             String                @id @default(cuid())
  userId         String?
  source         ModerationSource
  action         ModerationAction
  status         ModerationEventStatus @default(OPEN)
  contentHash    String
  contentExcerpt String                @default("") @db.Text
  matchedRules   Json
  context        Json?
  resolvedById   String?
  resolutionNote String                @default("") @db.Text
  resolvedAt     DateTime?
  createdAt      DateTime              @default(now())
  user           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  appeal         ModerationAppeal?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([source, action, createdAt])
}

model ModerationAppeal {
  id           String                    @id @default(cuid())
  eventId      String                    @unique
  userId       String
  status       ModerationAppealStatus    @default(PENDING)
  reason       String                    @db.Text
  reviewNote   String                    @default("") @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  event        ModerationEvent           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User                      @relation("ModerationAppealUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?                     @relation("ModerationAppealReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  history      ModerationAppealHistory[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model ModerationAppealHistory {
  id        String                 @id @default(cuid())
  appealId  String
  actorId   String?
  status    ModerationAppealStatus
  note      String                 @default("") @db.Text
  createdAt DateTime               @default(now())
  appeal    ModerationAppeal       @relation(fields: [appealId], references: [id], onDelete: Cascade)
  actor     User?                  @relation("ModerationAppealHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([appealId, createdAt])
}

model SupportTicket {
  id                 String                 @id @default(cuid())
  userId             String
  assignedToId       String?
  subject            String
  category           String                 @default("其他")
  status             SupportTicketStatus    @default(OPEN)
  priority           SupportTicketPriority  @default(NORMAL)
  lastUserMessageAt  DateTime?
  lastAdminMessageAt DateTime?
  userLastReadAt     DateTime?
  adminLastReadAt    DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  user               User                   @relation("SupportTicketRequester", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo         User?                  @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages           SupportTicketMessage[]

  @@index([userId, updatedAt])
  @@index([status, priority, updatedAt])
  @@index([assignedToId, status])
}

model SupportTicketMessage {
  id         String            @id @default(cuid())
  ticketId   String
  authorType SupportAuthorType
  authorId   String?
  body       String            @db.Text
  assetIds   String[]          @default([])
  createdAt  DateTime          @default(now())
  ticket     SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User?             @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([authorId, createdAt])
}

model ContentPage {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  category    String    @default("关于我们")
  summary     String    @default("") @db.Text
  contentHtml String    @db.Text
  coverUrl    String    @default("")
  published   Boolean   @default(false)
  sortOrder   Int       @default(0)
  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, sortOrder, updatedAt])
  @@index([category, published])
}

model PublishedWork {
  id                 String                 @id @default(cuid())
  userId             String
  slug               String                 @unique
  sourceType         String                 @default("ASSET")
  sourceId           String?
  lifecycleStatus    WorkLifecycleStatus    @default(ACTIVE)
  currentVersionId   String?                @unique
  publishedVersionId String?                @unique
  isFeatured         Boolean                @default(false)
  featuredAt         DateTime?
  viewCount          Int                    @default(0)
  likeCount          Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentVersion     PublishedWorkVersion?  @relation("WorkCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  publishedVersion   PublishedWorkVersion?  @relation("WorkPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions           PublishedWorkVersion[] @relation("WorkVersions")
  likes              WorkLike[]
  reports            WorkReport[]

  @@index([userId, updatedAt])
  @@index([lifecycleStatus, isFeatured, featuredAt])
  @@index([lifecycleStatus, viewCount, updatedAt])
}

model PublishedWorkVersion {
  id               String               @id @default(cuid())
  workId           String
  versionNumber    Int
  title            String
  description      String               @default("") @db.Text
  category         String               @default("")
  tags             String[]             @default([])
  visibility       WorkVisibility       @default(PRIVATE)
  authorDisplay    WorkAuthorDisplay    @default(PROFILE)
  customAuthor     String               @default("")
  publicPrompt     String               @default("") @db.Text
  moderationStatus WorkModerationStatus @default(DRAFT)
  rejectionReason  String               @default("") @db.Text
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  work             PublishedWork        @relation("WorkVersions", fields: [workId], references: [id], onDelete: Cascade)
  currentFor       PublishedWork?       @relation("WorkCurrentVersion")
  publishedFor     PublishedWork?       @relation("WorkPublishedVersion")
  reviewedBy       User?                @relation("WorkVersionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  assets           PublishedWorkAsset[]

  @@unique([workId, versionNumber])
  @@index([moderationStatus, submittedAt])
  @@index([visibility, reviewedAt])
  @@index([category, reviewedAt])
  @@index([tags], type: Gin)
}

model PublishedWorkAsset {
  versionId String
  assetId   String
  role      WorkAssetRole        @default(CONTENT)
  sortOrder Int                  @default(0)
  caption   String               @default("")
  version   PublishedWorkVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  asset     Asset                @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([versionId, assetId])
  @@index([assetId])
}

model WorkLike {
  workId    String
  userId    String
  createdAt DateTime      @default(now())
  work      PublishedWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workId, userId])
  @@index([userId, createdAt])
}

model UserFollow {
  followerId String
  followedId String
  createdAt  DateTime @default(now())
  follower   User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followed   User     @relation("UserFollowers", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId, createdAt])
}

model WorkReport {
  id           String           @id @default(cuid())
  workId       String
  reporterId   String
  reason       String
  details      String           @default("") @db.Text
  status       WorkReportStatus @default(PENDING)
  resolution   String           @default("") @db.Text
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  work         PublishedWork    @relation(fields: [workId], references: [id], onDelete: Cascade)
  reporter     User             @relation("WorkReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy   User?            @relation("WorkReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([workId, reporterId])
}
