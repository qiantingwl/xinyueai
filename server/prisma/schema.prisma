generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AssetKind {
  IMAGE
  VIDEO
  FILE
  PRODUCT_PACK
}

enum JobKind {
  CHAT
  IMAGE
  VIDEO
  COMMERCE
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum GenerationSettlementStatus {
  PENDING
  RESERVED
  SETTLED
  RELEASED
  REFUNDED
  RECONCILING
}

enum TokenQuotaMode {
  BILLABLE_UNITS
}

enum TokenOverageMode {
  BLOCK
  OVERAGE_CREDITS
}

enum ByokQuotaMode {
  QUOTA
  FREE
}

enum TokenQuotaStatus {
  ACTIVE
  EXPIRED
  EXHAUSTED
}

enum TokenQuotaReservationStatus {
  RESERVED
  SETTLED
  RELEASED
}

enum TokenUsageSource {
  PROVIDER
  TOKENIZER
  RESERVED
  MANUAL
}

enum TokenSettlementStatus {
  RESERVED
  SETTLED
  RELEASED
  REFUNDED
  RECONCILING
}

enum TokenLedgerType {
  RESERVE
  CHARGE
  RELEASE
  REFUND
  ADJUST
}

enum TokenQuotaEventType {
  GRANT
  RESERVE
  RELEASE
  CHARGE
  REFUND
  EXPIRE
  ADJUST
}

enum AgentTaskStatus {
  DRAFT
  QUEUED
  RUNNING
  WAITING_APPROVAL
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum AgentTaskStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum LedgerType {
  GRANT
  PURCHASE
  SPEND
  REFUND
  ADJUST
  INVITE
  REDEEM
}

enum BillingTransactionType {
  PRE_AUTH
  CAPTURE
  REFUND
  ADJUST
}

enum BillingTransactionDirection {
  DEBIT
  CREDIT
}

enum BillingTransactionStatus {
  RECORDED
  VOID
}

enum FeatureFlagScope {
  GLOBAL
  USER
}

enum ExportJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  EXPIRED
}

enum NotificationType {
  SYSTEM
  JOB
  CREDIT
  INVITE
  SUPPORT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WEBHOOK
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum InspirationMode {
  IMAGE
  VIDEO
  COMMERCE
  IMAGE_TOOL
}

enum ProviderType {
  OPENAI
  NEW_API
  SUB2API
  OPENAI_COMPATIBLE
  POLLINATIONS
  LOCAL_WORKER
}

enum ProviderAuthType {
  BEARER
  X_API_KEY
  BOTH
}

enum ModelCapability {
  CHAT
  IMAGE
  VIDEO
  COMMERCE
}

enum RechargeOrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PlanBillingCycle {
  MONTHLY
  YEARLY
  ONE_TIME
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum SubscriptionOrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum CouponDiscountType {
  FIXED
  PERCENT
}

enum UserCouponStatus {
  AVAILABLE
  LOCKED
  REDEEMED
  EXPIRED
  REVOKED
}

enum CouponRedemptionStatus {
  REDEEMED
  REFUNDED
}

enum ReferralStatus {
  REGISTERED
  COOLING
  REVIEW_REQUIRED
  APPROVED
  REWARDED
  REJECTED
  REVERSED
}

enum AccountDeletionStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum InvoiceStatus {
  REQUESTED
  REVIEWING
  ISSUED
  REJECTED
  CANCELLED
}

enum RenewalAttemptStatus {
  SCHEDULED
  PROCESSING
  PAYMENT_REQUIRED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ModerationRuleType {
  KEYWORD
  REGEX
}

enum ModerationAction {
  LOG
  REVIEW
  BLOCK
}

enum ModerationSource {
  CHAT
  IMAGE
  COMMERCE
  FILE_NAME
  SUPPORT
  WORK
}

enum WorkLifecycleStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum WorkVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum WorkModerationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  TAKEN_DOWN
}

enum WorkAuthorDisplay {
  PROFILE
  CUSTOM
  HIDDEN
}

enum WorkAssetRole {
  COVER
  CONTENT
}

enum WorkReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ModerationEventStatus {
  OPEN
  APPROVED
  DISMISSED
}

enum ModerationAppealStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportAuthorType {
  USER
  ADMIN
  SYSTEM
}

enum PluginVisibility {
  OFFICIAL
  PRIVATE
}

enum PluginStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum PluginCapability {
  CHAT
  IMAGE
  VIDEO
  COMMERCE
  OFFICE
}

enum WebSearchProviderType {
  SEARXNG
  TAVILY
  SERPER
  BRAVE
  EXA
  CUSTOM
}

model User {
  id                      String                    @id @default(cuid())
  email                   String?                   @unique
  username                String?                   @unique
  displayName             String
  avatarUrl               String?
  passwordHash            String?
  company                 String                    @default("")
  phone                   String                    @default("")
  tags                    String[]                  @default([])
  adminNote               String                    @default("") @db.Text
  role                    UserRole                  @default(USER)
  adminRoleId             String?
  status                  UserStatus                @default(ACTIVE)
  emailVerifiedAt         DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  sessions                Session[]
  externalIdentities      ExternalIdentity[]
  settings                UserSettings?
  creditAccount           CreditAccount?
  projects                Project[]
  canvases                CanvasDocument[]
  projectMemberships      ProjectMember[]
  projectSkillVersions    ProjectSkillVersion[]
  conversations           Conversation[]
  authoredMessages        Message[]                 @relation("MessageAuthor")
  deletedMessages         Message[]                 @relation("MessageDeletedBy")
  assets                  Asset[]
  jobs                    GenerationJob[]
  notifications           Notification[]
  notificationDeliveries  NotificationDelivery[]
  auditLogs               AuditLog[]                @relation("ActorAuditLogs")
  invitations             Invitation[]              @relation("Inviter")
  invitedBy               Invitation?               @relation("Invitee")
  referralCode            ReferralCode?
  groupMemberships        UserGroupMember[]
  apiCredentials          UserApiCredential[]
  privateModels           UserModel[]
  rechargeOrders          RechargeOrder[]
  subscriptions           UserSubscription[]
  subscriptionOrders      SubscriptionOrder[]
  userCoupons             UserCoupon[]
  paymentTransactions     PaymentTransaction[]
  paymentRefunds          PaymentRefund[]
  billingTransactions     BillingTransaction[]
  usageRecords            UsageRecord[]
  tokenQuotas             UserTokenQuota[]
  tokenUsageLedgers       TokenUsageLedger[]
  tokenQuotaEvents        TokenQuotaEvent[]
  tokenQuotaReservations  TokenQuotaReservation[]
  moderationEvents        ModerationEvent[]
  moderationAppeals       ModerationAppeal[]        @relation("ModerationAppealUser")
  reviewedAppeals         ModerationAppeal[]        @relation("ModerationAppealReviewer")
  appealHistoryEntries    ModerationAppealHistory[] @relation("ModerationAppealHistoryActor")
  supportTickets          SupportTicket[]           @relation("SupportTicketRequester")
  assignedTickets         SupportTicket[]           @relation("SupportTicketAssignee")
  supportMessages         SupportTicketMessage[]    @relation("SupportMessageAuthor")
  knowledgeBases          KnowledgeBase[]           @relation("KnowledgeBaseCreator")
  ownedTeams              Team[]                    @relation("TeamOwner")
  teamMemberships         TeamMember[]
  teamInvitationsSent     TeamInvitation[]          @relation("TeamInvitationSender")
  teamInvitationsAccepted TeamInvitation[]          @relation("TeamInvitationAccepter")
  teamAuditLogs           TeamAuditLog[]            @relation("TeamAuditActor")
  toolCallAudits          ToolCallAudit[]
  toolApprovalRequests    ToolApprovalRequest[]     @relation("ToolApprovalRequester")
  reviewedToolApprovals   ToolApprovalRequest[]     @relation("ToolApprovalReviewer")
  privatePlugins          Plugin[]                  @relation("PluginOwner")
  pluginInstallations     PluginInstallation[]
  pluginUsages            PluginUsage[]
  agentTasks              AgentTask[]
  agentSchedules          AgentSchedule[]
  teamCreditEntries       TeamCreditLedger[]        @relation("TeamCreditActor")
  adminRole               AdminRole?                @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)
  accountDeletionRequests AccountDeletionRequest[]
  billingProfile          BillingProfile?
  invoiceRequests         InvoiceRequest[]
  publishedWorks          PublishedWork[]
  reviewedWorkVersions    PublishedWorkVersion[]    @relation("WorkVersionReviewer")
  workLikes               WorkLike[]
  following               UserFollow[]              @relation("UserFollowing")
  followers               UserFollow[]              @relation("UserFollowers")
  workReports             WorkReport[]              @relation("WorkReporter")
  resolvedWorkReports     WorkReport[]              @relation("WorkReportResolver")
  exportJobs              ExportJob[]

  @@index([adminRoleId])
}

model AdminRole {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String   @default("") @db.Text
  permissions String[] @default([])
  builtIn     Boolean  @default(false)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@index([enabled, createdAt])
}

model AccountDeletionRequest {
  id             String                @id @default(cuid())
  userId         String
  status         AccountDeletionStatus @default(REQUESTED)
  reason         String                @default("") @db.Text
  requestedAt    DateTime              @default(now())
  scheduledAt    DateTime
  processingAt   DateTime?
  cancelledAt    DateTime?
  completedAt    DateTime?
  failureReason  String                @default("") @db.Text
  retentionNotes String                @default("") @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([status, scheduledAt])
}

model ExternalIdentity {
  id          String    @id @default(cuid())
  userId      String
  provider    String
  subject     String
  email       String?
  displayName String?
  avatarUrl   String?
  profile     Json?
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@index([provider, email])
}

model UserGroup {
  id                String                 @id @default(cuid())
  name              String                 @unique
  description       String                 @default("") @db.Text
  color             String                 @default("#2563eb")
  enabled           Boolean                @default(true)
  restrictModels    Boolean                @default(false)
  creditRatePercent Int                    @default(100)
  allowUserByok     Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  members           UserGroupMember[]
  campaigns         AnnouncementCampaign[]
  modelAccess       UserGroupModelAccess[]
}

model UserGroupMember {
  groupId    String
  userId     String
  assignedAt DateTime  @default(now())
  group      UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  ipAddress  String?
  userAgent  String?
  authMethod String    @default("email")
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model OtpCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, expiresAt])
}

model AuthTicket {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  kind       String
  provider   String    @default("")
  subject    String    @default("")
  email      String?
  profile    Json?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([kind, expiresAt])
  @@index([provider, subject])
}

model UserSettings {
  id                   String  @id @default(cuid())
  userId               String  @unique
  appearance           String  @default("dark")
  language             String  @default("zh-CN")
  responseStyle        String  @default("default")
  responseDetail       String  @default("auto")
  replyLanguage        String  @default("follow")
  customInstructions   String  @default("") @db.Text
  nickname             String  @default("")
  occupation           String  @default("")
  bio                  String  @default("") @db.Text
  useMemory            Boolean @default(true)
  referenceChats       Boolean @default(true)
  notifications        Boolean @default(true)
  chatHistoryEnabled   Boolean @default(true)
  trainingOptOut       Boolean @default(true)
  temporaryChatDefault Boolean @default(false)
  dataRetentionDays    Int     @default(0)
  shareUsageAnalytics  Boolean @default(false)
  onboarded            Boolean @default(true)
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditAccount {
  id        String         @id @default(cuid())
  userId    String         @unique
  balance   Int            @default(0)
  version   Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   CreditLedger[]
}

model CreditLedger {
  id             String        @id @default(cuid())
  accountId      String
  type           LedgerType
  amount         Int
  balanceAfter   Int
  idempotencyKey String?       @unique
  referenceType  String?
  referenceId    String?
  description    String
  metadata       Json?
  createdAt      DateTime      @default(now())
  account        CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([referenceType, referenceId])
}

model Project {
  id                   String                @id @default(cuid())
  userId               String
  teamId               String?
  name                 String
  description          String                @default("") @db.Text
  instructions         String                @default("") @db.Text
  workflowStatus       String                @default("PLANNING")
  workflowConfig       Json?
  defaultModel         String                @default("")
  defaultAssistantId   String?
  revision             Int                   @default(1)
  skillRevision        Int                   @default(0)
  activeSkillVersionId String?               @unique
  archivedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team                 Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  defaultAssistant     Assistant?            @relation(fields: [defaultAssistantId], references: [id], onDelete: SetNull)
  conversations        Conversation[]
  assets               Asset[]
  jobs                 GenerationJob[]
  versions             ProjectVersion[]
  agentTasks           AgentTask[]
  members              ProjectMember[]
  canvases             CanvasDocument[]
  activeSkillVersion   ProjectSkillVersion?  @relation("ProjectActiveSkill", fields: [activeSkillVersionId], references: [id], onDelete: SetNull)
  skillVersions        ProjectSkillVersion[] @relation("ProjectSkillVersions")

  @@index([userId, updatedAt])
  @@index([teamId, updatedAt])
  @@index([defaultAssistantId])
}

model CanvasDocument {
  id         String    @id @default(cuid())
  userId     String
  projectId  String?
  title      String
  kind       String    @default("FREEFORM")
  document   Json
  revision   Int       @default(1)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, archivedAt, updatedAt])
  @@index([projectId, updatedAt])
}

model ProjectMember {
  projectId String
  userId    String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId, joinedAt])
}

enum ProjectSkillChangeType {
  MANUAL
  SUMMARY
  RESTORE
  DISABLE
}

model ProjectSkillVersion {
  id                   String                 @id @default(cuid())
  projectId            String
  version              Int
  name                 String
  content              String                 @db.Text
  enabled              Boolean                @default(true)
  changeType           ProjectSkillChangeType
  changeSummary        String                 @default("") @db.Text
  previousVersionId    String?
  sourceConversationId String?
  createdById          String
  createdAt            DateTime               @default(now())
  project              Project                @relation("ProjectSkillVersions", fields: [projectId], references: [id], onDelete: Cascade)
  activeForProject     Project?               @relation("ProjectActiveSkill")
  previousVersion      ProjectSkillVersion?   @relation("ProjectSkillPrevious", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions         ProjectSkillVersion[]  @relation("ProjectSkillPrevious")
  sourceConversation   Conversation?          @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  createdBy            User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@index([createdById, createdAt])
  @@index([sourceConversationId])
}

model ProjectVersion {
  id            String   @id @default(cuid())
  projectId     String
  version       Int
  label         String   @default("")
  changeSummary String   @default("") @db.Text
  snapshot      Json
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

model Conversation {
  id                  String                @id @default(cuid())
  userId              String
  projectId           String?
  title               String                @default("新对话")
  model               String
  archivedAt          DateTime?
  pinnedAt            DateTime?
  shareToken          String?               @unique
  sharedAt            DateTime?
  temporary           Boolean               @default(false)
  expiresAt           DateTime?
  activeLeafId        String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  project             Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages            Message[]
  jobs                GenerationJob[]
  agentTask           AgentTask?
  skillSourceVersions ProjectSkillVersion[]

  @@index([userId, updatedAt])
  @@index([userId, pinnedAt, updatedAt])
  @@index([temporary, expiresAt])
}

model Message {
  id             String         @id @default(cuid())
  conversationId String
  parentId       String?
  branchIndex    Int            @default(0)
  authorId       String?
  role           MessageRole
  content        String         @db.Text
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  metadata       Json?
  deletedAt      DateTime?
  deletedById    String?
  createdAt      DateTime       @default(now())
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parent         Message?       @relation("MessageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Message[]      @relation("MessageTree")
  author         User?          @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  deletedBy      User?          @relation("MessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  attachments    MessageAsset[]

  @@index([conversationId, createdAt])
  @@index([conversationId, parentId, branchIndex])
  @@index([authorId, createdAt])
  @@index([deletedAt])
}

model Asset {
  id                  String               @id @default(cuid())
  userId              String
  projectId           String?
  teamId              String?
  kind                AssetKind
  name                String
  objectKey           String               @unique
  storageDriver       String               @default("local")
  storageBucket       String               @default("")
  mimeType            String
  size                BigInt
  width               Int?
  height              Int?
  checksum            String?
  metadata            Json?
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team                Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  messages            MessageAsset[]
  outputs             JobOutput[]
  knowledgeBases      KnowledgeBaseAsset[]
  inspirationCovers   Inspiration[]        @relation("InspirationCover")
  publishedWorkAssets PublishedWorkAsset[]

  @@index([userId, createdAt])
  @@index([teamId, createdAt])
  @@index([storageDriver, createdAt])
}

model Inspiration {
  id           String          @id @default(cuid())
  mode         InspirationMode
  title        String
  prompt       String          @db.Text
  badge        String          @default("")
  coverUrl     String          @default("")
  coverAssetId String?
  model        String?
  options      Json?
  sortOrder    Int             @default(0)
  enabled      Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  coverAsset   Asset?          @relation("InspirationCover", fields: [coverAssetId], references: [id], onDelete: SetNull)

  @@index([mode, enabled, sortOrder])
}

model PromptTemplate {
  id          String   @id @default(cuid())
  title       String
  description String   @default("") @db.Text
  prompt      String   @db.Text
  category    String   @default("通用")
  variables   Json?
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, category, sortOrder])
}

model PluginCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("") @db.Text
  icon        String   @default("blocks")
  sortOrder   Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plugins     Plugin[]

  @@index([enabled, sortOrder])
}

model Plugin {
  id                 String               @id @default(cuid())
  ownerId            String?
  categoryId         String?
  name               String
  slug               String               @unique
  description        String               @default("") @db.Text
  instruction        String               @db.Text
  icon               String               @default("blocks")
  version            String               @default("1.0.0")
  capabilities       PluginCapability[]   @default([])
  recommendedModel   String               @default("")
  outputRequirements String               @default("") @db.Text
  config             Json?
  visibility         PluginVisibility     @default(PRIVATE)
  status             PluginStatus         @default(DRAFT)
  featured           Boolean              @default(false)
  priceCredits       Int                  @default(0)
  installCount       Int                  @default(0)
  usageCount         Int                  @default(0)
  errorCount         Int                  @default(0)
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  owner              User?                @relation("PluginOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  category           PluginCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  installations      PluginInstallation[]
  usages             PluginUsage[]

  @@index([visibility, status, featured, sortOrder])
  @@index([ownerId, updatedAt])
  @@index([categoryId, status])
}

model PluginInstallation {
  userId      String
  pluginId    String
  enabled     Boolean  @default(true)
  paidCredits Int      @default(0)
  settings    Json?
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
