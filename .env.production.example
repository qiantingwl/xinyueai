# Required by the PostgreSQL container.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Required: full PostgreSQL connection URL (uses the postgres service defined in docker-compose).
DATABASE_URL=postgresql://flux:replace-with-a-strong-database-password@postgres:5432/flux_studio
REDIS_URL=redis://redis:6379
# Replace with the final HTTPS origin before opening the service to users.
WEB_ORIGIN=http://localhost
COOKIE_SECURE=false
# Required: generate strong random values, e.g. `openssl rand -base64 48`
SESSION_SECRET=replace-with-a-random-64-char-string
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-random-64-char-string
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
