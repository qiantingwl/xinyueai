# Required by the PostgreSQL container and Docker Compose interpolation.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Leave blank for the /install wizard, or provide the complete production URL.
DATABASE_URL=
REDIS_URL=redis://redis:6379
# Replace with the final HTTPS origin before opening the service to users.
WEB_ORIGIN=http://localhost
COOKIE_SECURE=false
# Leave blank to let the first-run installer generate strong values.
SESSION_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
# Optional fixed installer token. Blank values are generated and printed once.
INSTALL_TOKEN=
