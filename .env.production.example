# Production defaults. Keep this value when deploying with Docker Compose.
NODE_ENV=production
# Required by the PostgreSQL container and Docker Compose interpolation.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://flux:${POSTGRES_PASSWORD}@postgres:5432/flux_studio?schema=public
REDIS_URL=redis://redis:6379
# The frontend is the only host-facing service. 0.0.0.0 allows direct access
# through http://SERVER_IP:XINYUE_HTTP_PORT after one-click installation.
# Set 127.0.0.1 only when a host reverse proxy owns external access.
XINYUE_HTTP_BIND=0.0.0.0
# Host port for the web UI and API proxy. Keep the browser entry on 6001.
XINYUE_HTTP_PORT=6001
# Replace with the final HTTPS origin before opening the service to users.
WEB_ORIGIN=http://localhost
# Optional when API and frontend share the first WEB_ORIGIN. Set explicitly
# when payment webhooks use a different public API origin.
PUBLIC_BASE_URL=
COOKIE_SECURE=false
# The bundled frontend is the only reverse proxy in front of the backend container.
TRUST_PROXY=1
HEALTH_CHECK_TIMEOUT_MS=3000
# Re-scan expired generation leases after worker restarts. This recovery loop
# cannot be disabled; invalid or non-positive values fall back to 30000 ms.
GENERATION_STALE_LEASE_REAPER_INTERVAL_MS=30000
SESSION_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-different-32-character-secret
# Required only while creating the first administrator. The installer generates this value.
INSTALL_TOKEN=replace-with-a-random-install-token
GLOBAL_RATE_LIMIT=600
ADMIN_LOGIN_RATE_LIMIT=8
# Optional startup seeding. Leave both blank to create the administrator at /install.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=超级管理员
# Set true for one restart only when intentionally rotating the seeded administrator password.
ADMIN_FORCE_PASSWORD_RESET=false
# File storage. Keep UPLOAD_DIR mounted even after enabling S3 until all legacy local assets are migrated.
UPLOAD_DIR=/app/uploads
STORAGE_DRIVER=local
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO, OSS gateway, etc.).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Safe lifecycle rules managed by Xinyue. Active asset objects are never expired automatically.
S3_ABORT_INCOMPLETE_UPLOAD_DAYS=7
S3_NONCURRENT_EXPIRATION_DAYS=30

# Production worker authentication token. Generate it even when optional
# worker profiles are disabled so no profile can later start unauthenticated.
LOCAL_WORKER_TOKEN=replace-with-a-random-worker-token
# Comma-separated host or host:port allowlist for LOCAL_WORKER channels.
# The bundled Compose service names are allowed by default when this is empty.
LOCAL_WORKER_ALLOWED_HOSTS=
LOCAL_WORKER_CONCURRENCY=1
LOCAL_WORKER_RESULT_TTL_SECONDS=604800
POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=1G
REDIS_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=512M
BACKEND_CPU_LIMIT=2.0
BACKEND_MEMORY_LIMIT=1G
FRONTEND_CPU_LIMIT=1.0
FRONTEND_MEMORY_LIMIT=256M
DAILYHOT_REDIS_CPU_LIMIT=1.0
DAILYHOT_REDIS_MEMORY_LIMIT=256M
DAILYHOT_CPU_LIMIT=1.0
DAILYHOT_MEMORY_LIMIT=512M
LOCAL_WORKER_CPU_LIMIT=2.0
LOCAL_WORKER_MEMORY_LIMIT=2G
LOCAL_WORKER_REMBG_MODEL=u2net
LOCAL_WORKER_IOPAINT_MODEL=lama
LOCAL_WORKER_IOPAINT_DEVICE=cpu
LOCAL_WORKER_REALESRGAN_DEVICE=cpu
LOCAL_WORKER_REALESRGAN_TILE=0
COMFYUI_URL=http://comfyui:8188
COMFYUI_TIMEOUT_SECONDS=600
COMFYUI_WORKFLOW_DIR=./workers/comfyui-gateway/workflows
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
# Opt in only after reviewing every enabled third-party source and its license.
PROMPT_LIBRARY_EXTERNAL_SYNC_ENABLED=false
EXTERNAL_SKILL_MARKET_ENABLED=false
